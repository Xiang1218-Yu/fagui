# 数据库连接（完整技术栈使用 PostgreSQL；本地免依赖快速启动可用 SQLite）
# DATABASE_URL=postgresql+psycopg://fagui:fagui@localhost:5432/fagui
DATABASE_URL=sqlite:///./data/app.db

# Redis / Celery（CRAWL_EAGER=true 时采集任务在 API 进程内同步执行，无需 Redis）
REDIS_URL=redis://localhost:6379/0
CRAWL_EAGER=true

# 内置演示监管站点地址（容器内部署时设为 http://backend:8000/demo-site/）
DEMO_BASE_URL=http://127.0.0.1:8000/demo-site/

# 安全
JWT_SECRET=please-change-me

# 快照存储目录
STORAGE_DIR=data/storage
DEMO_SITE_DIR=data/demo_site
