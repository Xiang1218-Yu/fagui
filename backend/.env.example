# 法规变更情报平台后端部署配置示例
# 复制为 .env 后按需修改；docker-compose 中 DATABASE_URL/REDIS_URL 会被覆盖为容器内服务地址

# 数据库连接（本地开发指向 localhost；compose 部署时自动指向 postgres 服务）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/regintel
# Redis 连接（Celery broker/backend）
REDIS_URL=redis://localhost:6379/0
# 页面快照与附件存储目录（容器内建议保持默认 /app/data/snapshots 并挂载卷）
SNAPSHOT_DIR=./data/snapshots
# 采集器 User-Agent，用于 robots.txt 规则匹配
CRAWL_USER_AGENT=RegIntelBot/1.0 (+https://example.org/regintel)
# 单个附件下载大小上限（字节），默认 20MB
MAX_ATTACHMENT_BYTES=20971520

# SMTP 邮件通知配置（留空则邮件通道发送失败，仅记录错误，不影响其他功能）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 是否使用 TLS（465 端口一般为 true，587 端口视服务商要求）
SMTP_USE_TLS=true
# 发件人地址
EMAIL_FROM=

# 首次启动播种 admin 账号的初始密码；留空则使用默认 admin123
# 无论用哪个初始密码，admin 首次登录后都会被强制要求修改密码
ADMIN_INITIAL_PASSWORD=
